{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultra Optimizer deployment profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "mode",
    "access",
    "environments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mode": {
      "enum": [
        "automatic",
        "custom",
        "local-only"
      ]
    },
    "access": {
      "type": "object",
      "required": [
        "level",
        "authorized_environments"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "repo-only",
            "read-only-infra",
            "read-only-metrics",
            "staging-profiling",
            "staging-modify",
            "production-modify"
          ]
        },
        "authorized_environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "credential_mechanism": {
          "enum": [
            "none",
            "environment",
            "secrets-manager",
            "cloud-identity",
            "ssh-agent",
            "other"
          ]
        }
      }
    },
    "priorities": {
      "type": "array",
      "items": {
        "enum": [
          "latency",
          "throughput",
          "cost",
          "reliability",
          "memory",
          "cold-start",
          "scalability",
          "simplicity"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "downtime_allowed": {
          "type": "boolean"
        },
        "downtime_window": {
          "type": "string",
          "maxLength": 200
        },
        "migrations_allowed": {
          "type": "boolean"
        },
        "spending_limit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "period": {
              "enum": [
                "hour",
                "day",
                "month",
                "one-time"
              ]
            }
          },
          "required": [
            "amount",
            "currency",
            "period"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/env"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "source": {
          "enum": [
            "detected-from-repository",
            "developer-provided",
            "verified-live",
            "unknown"
          ]
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "env": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "development",
            "staging",
            "production",
            "preview",
            "other"
          ]
        },
        "hosting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "#/$defs/fact"
            },
            "platform": {
              "$ref": "#/$defs/fact"
            },
            "region": {
              "$ref": "#/$defs/fact"
            },
            "location": {
              "$ref": "#/$defs/fact"
            },
            "hosting_type": {
              "enum": [
                "managed-paas",
                "serverless",
                "container",
                "kubernetes",
                "vps",
                "dedicated",
                "self-hosted",
                "local",
                "other",
                "unknown"
              ]
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "$ref": "#/$defs/fact"
            },
            "language_version": {
              "$ref": "#/$defs/fact"
            },
            "framework": {
              "$ref": "#/$defs/fact"
            },
            "os_family": {
              "$ref": "#/$defs/fact"
            },
            "cpu_arch": {
              "$ref": "#/$defs/fact"
            }
          }
        },
        "instance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vcpus": {
              "$ref": "#/$defs/fact"
            },
            "memory_mb": {
              "$ref": "#/$defs/fact"
            },
            "instance_type": {
              "$ref": "#/$defs/fact"
            },
            "replicas": {
              "$ref": "#/$defs/fact"
            },
            "cpu_quota_vcpus": {
              "$ref": "#/$defs/fact"
            }
          }
        },
        "datastores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "caches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "queues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "external_services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "role": {
                "enum": [
                  "public-api",
                  "internal-api",
                  "health",
                  "metrics",
                  "web",
                  "other"
                ]
              },
              "host_label": {
                "type": "string",
                "maxLength": 253
              },
              "authorized_for_active_testing": {
                "type": "boolean"
              }
            }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "web",
                "api",
                "batch",
                "streaming",
                "realtime",
                "game",
                "mixed",
                "unknown"
              ]
            },
            "peak_rps": {
              "$ref": "#/$defs/fact"
            },
            "p95_target_ms": {
              "$ref": "#/$defs/fact"
            },
            "traffic_pattern": {
              "enum": [
                "steady",
                "diurnal",
                "bursty",
                "spiky",
                "unknown"
              ]
            }
          }
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "engine": {
          "$ref": "#/$defs/fact"
        },
        "managed": {
          "type": "boolean"
        },
        "max_connections": {
          "$ref": "#/$defs/fact"
        }
      }
    }
  }
}