{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultra Optimizer server adaptation policy",
  "type": "object",
  "required": [
    "schema_version",
    "approved_by_developer",
    "parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "approved_by_developer": {
      "type": "boolean"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "min",
          "max",
          "default",
          "derived_from"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "worker_count",
              "concurrency",
              "memory_budget_mb",
              "cache_mb",
              "batch_size",
              "db_pool_size",
              "schedule_slots"
            ]
          },
          "min": {
            "type": "number",
            "minimum": 0
          },
          "max": {
            "type": "number",
            "minimum": 0
          },
          "default": {
            "type": "number",
            "minimum": 0
          },
          "derived_from": {
            "enum": [
              "effective_vcpus",
              "memory_limit_mb",
              "db_max_connections",
              "downstream_capacity",
              "fixed"
            ]
          },
          "fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "requires_verified": {
            "type": "boolean"
          },
          "safety_margin_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.9
          }
        }
      }
    }
  }
}